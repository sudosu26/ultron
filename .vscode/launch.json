{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ULTRON: Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/ultron/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            },
            "justMyCode": false
        },
        {
            "name": "ULTRON: Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/ultron/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            },
            "noDebug": true
        }
    ]
}